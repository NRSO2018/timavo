{
  "ConnectionStrings": {
    "DefaultConnection": "Host=127.0.0.1;Port=5432;Database=Timavo;Username=postgres;Password=TimavoAdmin."
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "File": {
      "Enabled": false,
      "Path": "/logs/timavo-.log",
      "RetainedFileCountLimit": 14
    }
  },
  "IdentityServer": {
    "Authority": "https://localhost:7047"
  },
  "TrashRetention": {
    "Days": 30,
    "PurgeIntervalHours": 24
  },
  "Mcp": {
    "Enabled": true,
    "ActivityRetention": {
      "Days": 90,
      "PurgeIntervalHours": 24
    }
  },
  "AllowedHosts": "*"
}
